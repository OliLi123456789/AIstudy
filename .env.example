# AIstudy — environment variables
# Copy this to .env for local dev. On Vercel, set these in the dashboard.

# DeepSeek API key — SERVER-SIDE ONLY. Never bundled into the client.
# The browser talks to /api/ai, which proxies to DeepSeek with this key.
DEEPSEEK_API_KEY

# Secret for signing session + admin tokens. Generate one with:
#   openssl rand -hex 32
TOKEN_SECRET

# Admin password for the /admin owner portal.
ADMIN_PASSWORD

# Optional abuse/spend guards (server-side)
# AI_GENERATION_DISABLED=1          # kill switch: blocks all generation
# AI_RPM=20                         # requests/minute per client
# AI_DAILY_TOKEN_BUDGET=200000      # tokens/day per client
# AI_DAILY_SPEND_CAP_USD=5          # business-wide spend cap per day

# Canvas OAuth2 credentials (optional — for "Sign in with Canvas" button).
# Create a Developer Key on your Canvas instance (Admin → Developer Keys)
# with Redirect URI: https://your-app.vercel.app/api/canvas-oauth?action
# CANVAS_CLIENT_ID
# CANVAS_CLIENT_SECRET
# CANVAS_URL

# Supabase — copy your values from Project Settings → Data API
# Publishable (anon) key: safe for the browser, RLS-enforced.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret (service_role) key: SERVER-ONLY. Goes in Vercel env settings,
# used exclusively by the api/ functions. Never in client code or git.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
